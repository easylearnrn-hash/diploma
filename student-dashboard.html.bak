<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Dashboard | Armenian College of Nursing & Health Sciences (ACNHS)</title>
<!-- Auth gate -->
<script>
(function(){
  var ok = sessionStorage.getItem('isLoggedIn') === 'true' ||
           localStorage.getItem('isLoggedIn')    === 'true';
  if (!ok) { window.location.replace('login.html'); }
})();
</script>
<link rel="icon" type="image/svg+xml" href="favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800;900&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<script src="js/supabase.min.js"></script>
<script src="js/supabase-config.js"></script>
<script src="js/acnhs-logo-base64.js"></script>

<style>
:root {
  --navy-deep:    #020617;
  --navy-primary: #0f172a;
  --navy-light:   #1e293b;
  --navy-border:  #334155;
  --gold-primary: #c9a84c;
  --gold-light:   #d4b56a;
  --gold-dim:     rgba(201,168,76,0.35);
  --gold-glow:    rgba(201,168,76,0.12);
  --text:         #e8edf5;
  --text-muted:   #8a9ec0;
  --border:       rgba(255,255,255,0.07);
  --success:      #10b981;
  --error:        #ef4444;
  --warning:      #f59e0b;
  --card-bg:      rgba(15,23,42,0.85);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Inter', system-ui, sans-serif;
  background:
    radial-gradient(ellipse at 15% 25%, rgba(201,168,76,0.05) 0%, transparent 50%),
    radial-gradient(ellipse at 85% 75%, rgba(15,23,42,0.9) 0%, transparent 60%),
    linear-gradient(160deg, #020a1a 0%, #0a1628 50%, #050d1e 100%);
  color: var(--text);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

/* ── TOP NAV ── */
.top-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(2,6,23,0.96);
  border-bottom: 1px solid rgba(201,168,76,0.15);
  backdrop-filter: blur(12px);
  padding: 0 24px;
  height: 62px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
.nav-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}
.nav-brand img { width: 38px; height: 38px; object-fit: contain; }
.nav-brand-text {
  font-family: 'Playfair Display', serif;
  font-size: 16px;
  font-weight: 800;
  color: var(--gold-primary);
  letter-spacing: 0.3px;
  white-space: nowrap;
}
.nav-actions { display: flex; align-items: center; gap: 10px; }
.nav-back-btn {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 8px 16px;
  border-radius: 9px;
  border: 1.5px solid rgba(201,168,76,0.3);
  background: rgba(201,168,76,0.07);
  color: var(--gold-primary);
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.15s;
  font-family: 'Inter', sans-serif;
}
.nav-back-btn:hover {
  background: rgba(201,168,76,0.14);
  border-color: var(--gold-primary);
}
.nav-user-pill {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 5px 14px 5px 6px;
  border-radius: 999px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.10);
}
.nav-user-avatar {
  width: 30px; height: 30px;
  border-radius: 50%;
  background: rgba(201,168,76,0.15);
  border: 1.5px solid rgba(201,168,76,0.4);
  color: var(--gold-primary);
  font-weight: 900;
  font-size: 11px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.nav-user-name { font-size: 13px; font-weight: 600; color: #f1f5f9; white-space: nowrap; }

/* ── PAGE LAYOUT ── */
.page-wrap {
  max-width: 1100px;
  margin: 0 auto;
  padding: 40px 24px 80px;
}

/* ── PAGE HEADER ── */
.page-header {
  margin-bottom: 36px;
}
.page-header-eyebrow {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--gold-primary);
  margin-bottom: 10px;
}
.page-header h1 {
  font-family: 'Playfair Display', serif;
  font-size: 34px;
  font-weight: 800;
  color: #f1f5f9;
  letter-spacing: -0.5px;
  line-height: 1.15;
  margin-bottom: 8px;
}
.page-header p {
  color: var(--text-muted);
  font-size: 15px;
  line-height: 1.65;
}

/* ── LOADING / ERROR STATES ── */
.state-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 60px 32px;
  text-align: center;
}
.state-icon { font-size: 44px; margin-bottom: 16px; }
.state-title { font-size: 18px; font-weight: 700; color: #f1f5f9; margin-bottom: 8px; }
.state-sub { color: var(--text-muted); font-size: 14px; line-height: 1.6; }
.spinner {
  width: 36px; height: 36px;
  border: 3px solid rgba(201,168,76,0.15);
  border-top-color: var(--gold-primary);
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
  margin: 0 auto 20px;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ── KPI SUMMARY ROW ── */
.kpi-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
  margin-bottom: 32px;
}
.kpi-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 22px 20px;
  transition: border-color 0.2s, transform 0.2s;
  position: relative;
  overflow: hidden;
}
.kpi-card::before {
  content: '';
  position: absolute;
  top: -1px; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--gold-primary), transparent);
  opacity: 0;
  transition: opacity 0.2s;
}
.kpi-card:hover { border-color: var(--gold-dim); transform: translateY(-2px); }
.kpi-card:hover::before { opacity: 1; }
.kpi-label {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  color: var(--text-muted);
  margin-bottom: 8px;
}
.kpi-value {
  font-family: 'Playfair Display', serif;
  font-size: 36px;
  font-weight: 800;
  color: #f1f5f9;
  line-height: 1;
  margin-bottom: 4px;
}
.kpi-sub { font-size: 12px; color: var(--text-muted); }

/* ── SECTION ── */
.section { margin-bottom: 32px; }
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}
.section-title {
  font-family: 'Playfair Display', serif;
  font-size: 19px;
  font-weight: 700;
  color: #f1f5f9;
  display: flex;
  align-items: center;
  gap: 10px;
}
.section-title svg { color: var(--gold-primary); flex-shrink: 0; }

/* ── AVERAGE BANNER ── */
.avg-banner {
  background: linear-gradient(135deg, rgba(201,168,76,0.10) 0%, rgba(201,168,76,0.04) 100%);
  border: 1px solid rgba(201,168,76,0.25);
  border-radius: 18px;
  padding: 28px 32px;
  display: flex;
  align-items: center;
  gap: 28px;
  margin-bottom: 32px;
  flex-wrap: wrap;
}
.avg-letter-box {
  width: 72px; height: 72px;
  border-radius: 18px;
  display: flex; align-items: center; justify-content: center;
  font-size: 36px; font-weight: 900;
  flex-shrink: 0;
}
.avg-letter-box.A { background: rgba(16,185,129,0.15); color: #34d399; border: 2px solid rgba(16,185,129,0.35); }
.avg-letter-box.B { background: rgba(56,189,248,0.12); color: #38bdf8; border: 2px solid rgba(56,189,248,0.3); }
.avg-letter-box.C { background: rgba(245,158,11,0.12); color: #fbbf24; border: 2px solid rgba(245,158,11,0.3); }
.avg-letter-box.D { background: rgba(251,146,60,0.12); color: #fb923c; border: 2px solid rgba(251,146,60,0.3); }
.avg-letter-box.F { background: rgba(239,68,68,0.10); color: #f87171; border: 2px solid rgba(239,68,68,0.3); }
.avg-info { flex: 1; min-width: 180px; }
.avg-info-label {
  font-size: 11px; font-weight: 700; text-transform: uppercase;
  letter-spacing: 0.8px; color: var(--text-muted); margin-bottom: 4px;
}
.avg-info-pct {
  font-family: 'Playfair Display', serif;
  font-size: 44px; font-weight: 900; color: #f1f5f9;
  line-height: 1; margin-bottom: 4px;
}
.avg-info-sub { font-size: 13px; color: var(--text-muted); }
.avg-pills { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
.avg-pill {
  padding: 8px 18px;
  border-radius: 50px;
  font-size: 13px; font-weight: 700;
  display: flex; align-items: center; gap: 7px;
}
.avg-pill.pass { background: rgba(16,185,129,0.12); color: #34d399; border: 1px solid rgba(16,185,129,0.3); }
.avg-pill.fail { background: rgba(239,68,68,0.10); color: #f87171; border: 1px solid rgba(239,68,68,0.25); }

/* ── PROGRESS BAR ── */
.progress-bar-wrap {
  height: 8px;
  background: rgba(255,255,255,0.06);
  border-radius: 99px;
  overflow: hidden;
  margin-top: 10px;
}
.progress-bar-fill {
  height: 100%;
  border-radius: 99px;
  background: linear-gradient(90deg, var(--gold-primary), var(--gold-light));
  transition: width 0.8s cubic-bezier(0.4,0,0.2,1);
}

/* ── GRADE HISTORY TABLE ── */
.table-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 18px;
  overflow: hidden;
}
.table-search-bar {
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 10px;
}
.table-search-bar input {
  flex: 1;
  background: rgba(255,255,255,0.04);
  border: 1.5px solid rgba(255,255,255,0.10);
  border-radius: 9px;
  padding: 9px 14px;
  color: #f1f5f9;
  font-size: 13px;
  font-family: 'Inter', sans-serif;
  outline: none;
  transition: border-color 0.18s;
}
.table-search-bar input:focus { border-color: rgba(201,168,76,0.5); }
.table-search-bar input::placeholder { color: #475569; }
.data-table { width: 100%; border-collapse: collapse; }
.data-table thead th {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.7px;
  color: var(--text-muted);
  padding: 12px 16px;
  text-align: left;
  border-bottom: 1px solid var(--border);
  background: rgba(255,255,255,0.02);
  white-space: nowrap;
}
.data-table tbody td {
  padding: 13px 16px;
  font-size: 13px;
  color: #cbd5e1;
  border-bottom: 1px solid rgba(255,255,255,0.04);
  vertical-align: middle;
}
.data-table tbody tr:last-child td { border-bottom: none; }
.data-table tbody tr:hover td { background: rgba(255,255,255,0.025); }
.data-table tbody tr.latest-row td { background: rgba(201,168,76,0.04); }

/* Grade letter pills */
.g-pill {
  display: inline-flex; align-items: center; justify-content: center;
  width: 30px; height: 30px;
  border-radius: 8px;
  font-size: 13px; font-weight: 900;
}
.g-pill.A { background: rgba(16,185,129,0.15); color: #34d399; }
.g-pill.B { background: rgba(56,189,248,0.12); color: #38bdf8; }
.g-pill.C { background: rgba(245,158,11,0.12); color: #fbbf24; }
.g-pill.D { background: rgba(251,146,60,0.12); color: #fb923c; }
.g-pill.F { background: rgba(239,68,68,0.10); color: #f87171; }

.pass-chip {
  font-size: 10px; font-weight: 800; text-transform: uppercase;
  letter-spacing: 0.5px; padding: 3px 9px; border-radius: 50px;
}
.pass-chip.pass { background: rgba(16,185,129,0.12); color: #34d399; border: 1px solid rgba(16,185,129,0.25); }
.pass-chip.fail { background: rgba(239,68,68,0.10); color: #f87171; border: 1px solid rgba(239,68,68,0.2); }

.table-empty {
  text-align: center;
  padding: 48px 20px;
  color: var(--text-muted);
  font-size: 14px;
}
.table-empty svg { display: block; margin: 0 auto 14px; opacity: 0.4; }

/* ── TOPIC BREAKDOWN ── */
.topic-grid {
  display: grid;
  gap: 10px;
}
.topic-row-item {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 14px 18px;
  display: flex;
  align-items: center;
  gap: 14px;
  transition: border-color 0.2s;
}
.topic-row-item:hover { border-color: var(--gold-dim); }
.topic-name-col { flex: 1; min-width: 0; }
.topic-name-text { font-size: 13.5px; font-weight: 600; color: #e2e8f0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.topic-sub-text { font-size: 11px; color: var(--text-muted); margin-top: 1px; }
.topic-score-col { text-align: right; flex-shrink: 0; min-width: 80px; }
.topic-score-pct { font-size: 18px; font-weight: 800; color: #f1f5f9; }
.topic-score-count { font-size: 11px; color: var(--text-muted); }
.topic-bar-col { width: 120px; flex-shrink: 0; }

/* ── SCORE TREND MINI-CHART ── */
.trend-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 24px 20px;
}
.trend-chart-wrap {
  position: relative;
  height: 150px;
  margin-top: 16px;
}
.trend-chart-wrap canvas { width: 100% !important; }

/* ── RESPONSIVE ── */
@media (max-width: 640px) {
  .page-wrap { padding: 24px 14px 60px; }
  .page-header h1 { font-size: 26px; }
  .avg-banner { padding: 20px; gap: 16px; }
  .avg-info-pct { font-size: 36px; }
  .kpi-row { grid-template-columns: repeat(2, 1fr); }
  .data-table thead th:nth-child(3),
  .data-table tbody td:nth-child(3) { display: none; }
}
</style>
</head>
<body>

<!-- ── TOP NAV ── -->
<nav class="top-nav">
  <a class="nav-brand" href="test.html">
    <img id="navLogo" src="" alt="ACNHS" data-acnhs-logo>
    <span class="nav-brand-text">ACNHS</span>
  </a>
  <div class="nav-actions">
    <a class="nav-back-btn" href="test.html">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
      Back to Tests
    </a>
    <div class="nav-user-pill">
      <div class="nav-user-avatar" id="navAvatar">?</div>
      <span class="nav-user-name" id="navUserName">Student</span>
    </div>
  </div>
</nav>

<!-- ── MAIN ── -->
<div class="page-wrap">

  <!-- Header -->
  <div class="page-header">
    <div class="page-header-eyebrow">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
      My Test Dashboard
    </div>
    <h1>Performance Overview</h1>
    <p>Track your scores, grade history, and progress across all practice tests.</p>
  </div>

  <!-- Loading state -->
  <div id="loadingState" class="state-card">
    <div class="spinner"></div>
    <div class="state-title">Loading your data…</div>
    <div class="state-sub">Fetching grade history from the server.</div>
  </div>

  <!-- Error state -->
  <div id="errorState" class="state-card" style="display:none">
    <div class="state-icon">⚠️</div>
    <div class="state-title">Could not load data</div>
    <div class="state-sub" id="errorMsg">Please check your connection and try again.</div>
    <button onclick="loadDashboard()" style="margin-top:20px;padding:10px 24px;border-radius:9px;border:1.5px solid rgba(201,168,76,0.4);background:rgba(201,168,76,0.08);color:var(--gold-primary);font-weight:700;cursor:pointer;font-family:'Inter',sans-serif;font-size:13px">Retry</button>
  </div>

  <!-- Empty state -->
  <div id="emptyState" class="state-card" style="display:none">
    <div class="state-icon">📋</div>
    <div class="state-title">No tests taken yet</div>
    <div class="state-sub">Complete your first practice test to see your analytics here.</div>
    <a href="test.html" style="display:inline-block;margin-top:20px;padding:12px 28px;border-radius:10px;background:linear-gradient(135deg,var(--gold-primary),var(--gold-light));color:#0f172a;font-weight:800;font-size:14px;text-decoration:none">Start a Test →</a>
  </div>

  <!-- Dashboard content (hidden until data loads) -->
  <div id="dashContent" style="display:none">

    <!-- KPI Row -->
    <div class="kpi-row" id="kpiRow"></div>

    <!-- Average Banner -->
    <div class="avg-banner" id="avgBanner"></div>

    <!-- Two-column: trend + topic breakdown -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:32px" id="midGrid">

      <!-- Score trend -->
      <div class="section">
        <div class="section-header">
          <div class="section-title">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            Score Trend
          </div>
        </div>
        <div class="trend-card">
          <div id="trendEmpty" style="text-align:center;color:var(--text-muted);font-size:13px;padding:40px 0">
            Take at least 2 tests to see your trend.
          </div>
          <div class="trend-chart-wrap" id="trendChartWrap" style="display:none">
            <canvas id="trendCanvas"></canvas>
          </div>
        </div>
      </div>

      <!-- Per-topic breakdown -->
      <div class="section">
        <div class="section-header">
          <div class="section-title">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            By Subject / Topic
          </div>
        </div>
        <div class="topic-grid" id="topicGrid">
          <div style="text-align:center;color:var(--text-muted);font-size:13px;padding:32px 0">Loading topics…</div>
        </div>
      </div>
    </div>

    <!-- Grade History Table -->
    <div class="section">
      <div class="section-header">
        <div class="section-title">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          Full Grade History
        </div>
        <span id="historyCount" style="font-size:12px;color:var(--text-muted);font-weight:600"></span>
      </div>
      <div class="table-card">
        <div class="table-search-bar">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input type="text" id="historySearch" placeholder="Search by test name or topic…" oninput="filterHistory(this.value)">
        </div>
        <div style="overflow-x:auto">
          <table class="data-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Test</th>
                <th>Topics</th>
                <th>Score</th>
                <th>Grade</th>
                <th>Status</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody id="historyTableBody"></tbody>
          </table>
          <div id="historyEmpty" class="table-empty" style="display:none">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            No results match your search.
          </div>
        </div>
      </div>
    </div>

  </div><!-- /#dashContent -->

</div><!-- /.page-wrap -->

<!-- Chart.js (lightweight, loaded only on this page) -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
// ── Logo ─────────────────────────────────────────────────────────────────
(function setLogos() {
  const src = window.ACNHS_LOGO_DATA_URL
    || (window.ACNHS_LOGO_BASE64 ? 'data:image/png;base64,' + window.ACNHS_LOGO_BASE64 : '');
  document.querySelectorAll('[data-acnhs-logo]').forEach(el => { if (src) el.src = src; });
})();

// ── User identity ─────────────────────────────────────────────────────────
function getOwnerId() {
  return sessionStorage.getItem('userEmail')
    || localStorage.getItem('userEmail')
    || sessionStorage.getItem('teacherEmail')
    || localStorage.getItem('teacherEmail')
    || 'anonymous';
}
function getUserName() {
  return sessionStorage.getItem('userName')
    || localStorage.getItem('userName')
    || sessionStorage.getItem('teacherName')
    || localStorage.getItem('teacherName')
    || getOwnerId();
}

(function initUserPill() {
  const name = getUserName();
  const initials = name.split(/\s+/).map(p => p[0] || '').join('').toUpperCase().slice(0, 2) || '?';
  document.getElementById('navAvatar').textContent = initials;
  document.getElementById('navUserName').textContent = name.split(' ')[0] || name;
})();

// ── Utilities ─────────────────────────────────────────────────────────────
function gradeFromPct(p) {
  if (p >= 90) return 'A';
  if (p >= 80) return 'B';
  if (p >= 70) return 'C';
  if (p >= 60) return 'D';
  return 'F';
}
function fmtDate(iso) {
  return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
function escHtml(str) {
  return String(str || '')
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;');
}

// ── All history rows (for search filter) ─────────────────────────────────
let _allRows = [];

// ── Main load ────────────────────────────────────────────────────────────
async function loadDashboard() {
  show('loadingState');
  hide('errorState'); hide('emptyState'); hide('dashContent');

  try {
    const sdb = initSupabase();
    const ownerId = getOwnerId();

    const { data, error } = await sdb
      .from('test_grade_history')
      .select('*')
      .eq('owner_id', ownerId)
      .order('taken_at', { ascending: false });

    if (error) throw error;

    hide('loadingState');

    if (!data || data.length === 0) {
      show('emptyState');
      return;
    }

    _allRows = data;
    renderDashboard(data);
    show('dashContent');

  } catch (e) {
    hide('loadingState');
    document.getElementById('errorMsg').textContent = e.message || 'Unknown error';
    show('errorState');
  }
}

function show(id) { const el = document.getElementById(id); if (el) el.style.display = ''; }
function hide(id) { const el = document.getElementById(id); if (el) el.style.display = 'none'; }

// ── Full render ───────────────────────────────────────────────────────────
function renderDashboard(rows) {
  const scoredRows  = rows.filter(r => typeof r.score_percent === 'number');
  const total       = scoredRows.length;
  const avg         = total ? Math.round(scoredRows.reduce((s, r) => s + r.score_percent, 0) / total) : 0;
  const passCount   = scoredRows.filter(r => r.score_percent >= 70).length;
  const failCount   = total - passCount;
  const passRate    = total ? Math.round((passCount / total) * 100) : 0;
  const best        = total ? Math.max(...scoredRows.map(r => r.score_percent)) : 0;
  const avgLetter   = gradeFromPct(avg);

  renderKPIs(total, avg, passRate, best);
  renderAvgBanner(avg, avgLetter, passCount, failCount);
  renderTrend(scoredRows);
  renderTopics(rows);
  renderTable(rows);
  document.getElementById('historyCount').textContent = total + ' attempt' + (total !== 1 ? 's' : '');
}

// ── KPI cards ─────────────────────────────────────────────────────────────
function renderKPIs(total, avg, passRate, best) {
  const items = [
    { label: 'Tests Taken',    value: total,        sub: 'all attempts'               },
    { label: 'Avg Score',      value: avg + '%',    sub: gradeFromPct(avg) + ' average' },
    { label: 'Pass Rate',      value: passRate + '%', sub: '≥ 70% to pass'            },
    { label: 'Best Score',     value: best + '%',   sub: 'personal record'            },
  ];
  document.getElementById('kpiRow').innerHTML = items.map(k => `
    <div class="kpi-card">
      <div class="kpi-label">${k.label}</div>
      <div class="kpi-value">${k.value}</div>
      <div class="kpi-sub">${k.sub}</div>
    </div>`).join('');
}

// ── Average banner ────────────────────────────────────────────────────────
function renderAvgBanner(avg, letter, passCount, failCount) {
  document.getElementById('avgBanner').innerHTML = `
    <div class="avg-letter-box ${letter}">${letter}</div>
    <div class="avg-info">
      <div class="avg-info-label">Cumulative Average</div>
      <div class="avg-info-pct">${avg}%</div>
      <div class="avg-info-sub">Based on all submitted tests</div>
      <div class="progress-bar-wrap" style="max-width:220px;margin-top:10px">
        <div class="progress-bar-fill" style="width:${avg}%"></div>
      </div>
    </div>
    <div class="avg-pills">
      <div class="avg-pill pass">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        ${passCount} Passed
      </div>
      ${failCount > 0 ? `<div class="avg-pill fail">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        ${failCount} Failed
      </div>` : ''}
    </div>`;
}

// ── Score trend chart ─────────────────────────────────────────────────────
let _trendChart = null;
function renderTrend(rows) {
  // Chronological order for chart
  const chrono = [...rows].reverse().slice(-15); // last 15 attempts
  if (chrono.length < 2) { return; } // keep empty message

  hide('trendEmpty');
  document.getElementById('trendChartWrap').style.display = '';

  const labels = chrono.map((r, i) => '#' + (i + 1));
  const scores = chrono.map(r => r.score_percent);
  const colors = scores.map(s => s >= 70 ? 'rgba(16,185,129,0.85)' : 'rgba(239,68,68,0.75)');

  if (_trendChart) { _trendChart.destroy(); }

  const ctx = document.getElementById('trendCanvas').getContext('2d');
  _trendChart = new Chart(ctx, {
    type: 'line',
    data: {
      labels,
      datasets: [{
        label: 'Score %',
        data: scores,
        borderColor: '#c9a84c',
        backgroundColor: 'rgba(201,168,76,0.07)',
        borderWidth: 2.5,
        pointBackgroundColor: colors,
        pointBorderColor: colors,
        pointRadius: 5,
        pointHoverRadius: 7,
        tension: 0.35,
        fill: true,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 600 },
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#1e293b',
          borderColor: 'rgba(201,168,76,0.3)',
          borderWidth: 1,
          titleColor: '#94a3b8',
          bodyColor: '#f1f5f9',
          callbacks: {
            title: (items) => {
              const idx = items[0].dataIndex;
              return chrono[idx] ? fmtDate(chrono[idx].taken_at) : '';
            },
            label: (item) => ` Score: ${item.raw}%`
          }
        }
      },
      scales: {
        x: {
          grid: { color: 'rgba(255,255,255,0.04)' },
          ticks: { color: '#475569', font: { size: 11 } }
        },
        y: {
          min: 0, max: 100,
          grid: { color: 'rgba(255,255,255,0.05)' },
          ticks: {
            color: '#475569', font: { size: 11 },
            callback: v => v + '%'
          }
        }
      }
    }
  });
}

// ── Per-topic breakdown ───────────────────────────────────────────────────
function renderTopics(rows) {
  // Build map: topic → { correct, total }
  const map = {};
  rows.forEach(r => {
    const topic = r.topics || r.test_title || 'General';
    // Each row represents one test; use score to approximate topic performance
    if (!map[topic]) map[topic] = { scoreSum: 0, count: 0 };
    map[topic].scoreSum += r.score_percent;
    map[topic].count++;
  });

  const entries = Object.entries(map)
    .map(([name, d]) => ({ name, avg: Math.round(d.scoreSum / d.count), count: d.count }))
    .sort((a, b) => b.avg - a.avg)
    .slice(0, 8);

  if (entries.length === 0) {
    document.getElementById('topicGrid').innerHTML =
      '<div style="text-align:center;color:var(--text-muted);font-size:13px;padding:32px 0">No topic data available.</div>';
    return;
  }

  document.getElementById('topicGrid').innerHTML = entries.map(e => {
    const letter = gradeFromPct(e.avg);
    const barColor = e.avg >= 70 ? '#10b981' : e.avg >= 60 ? '#f59e0b' : '#ef4444';
    return `
    <div class="topic-row-item">
      <div class="topic-name-col">
        <div class="topic-name-text">${escHtml(e.name)}</div>
        <div class="topic-sub-text">${e.count} test${e.count !== 1 ? 's' : ''}</div>
      </div>
      <div class="topic-bar-col">
        <div class="progress-bar-wrap">
          <div class="progress-bar-fill" style="width:${e.avg}%;background:${barColor}"></div>
        </div>
      </div>
      <div class="topic-score-col">
        <div class="topic-score-pct">${e.avg}%</div>
        <div class="topic-score-count">${letter}</div>
      </div>
    </div>`;
  }).join('');
}

// ── Grade history table ───────────────────────────────────────────────────
function renderTable(rows) {
  renderTableRows(rows);
}

function renderTableRows(rows) {
  const tbody = document.getElementById('historyTableBody');
  const empty = document.getElementById('historyEmpty');

  if (!rows || rows.length === 0) {
    tbody.innerHTML = '';
    empty.style.display = '';
    return;
  }
  empty.style.display = 'none';

  // Newest-first already; add display index newest=1
  tbody.innerHTML = rows.map((r, idx) => {
    const letter  = r.letter_grade || gradeFromPct(r.score_percent);
    const passed  = r.score_percent >= 70;
    const isFirst = idx === 0;
    return `
    <tr class="${isFirst ? 'latest-row' : ''}">
      <td style="color:#475569;font-size:11px">${rows.length - idx}</td>
      <td>
        <div style="font-weight:600;color:#e2e8f0;max-width:220px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${escHtml(r.test_title || '—')}</div>
        ${isFirst ? '<span style="font-size:10px;color:var(--gold-primary);font-weight:700">Latest</span>' : ''}
      </td>
      <td style="max-width:160px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#64748b;font-size:12px">
        ${escHtml(r.topics || '—')}
      </td>
      <td>
        <span style="font-size:16px;font-weight:800;color:#f1f5f9">${r.score_percent}%</span>
        <span style="font-size:11px;color:#475569;display:block">${r.correct_count}/${r.total_questions}</span>
      </td>
      <td><span class="g-pill ${letter}">${letter}</span></td>
      <td><span class="pass-chip ${passed ? 'pass' : 'fail'}">${passed ? 'Pass' : 'Fail'}</span></td>
      <td style="color:#64748b;font-size:12px;white-space:nowrap">${fmtDate(r.taken_at)}</td>
    </tr>`;
  }).join('');
}

function filterHistory(q) {
  q = (q || '').toLowerCase().trim();
  if (!q) { renderTableRows(_allRows); return; }
  const filtered = _allRows.filter(r =>
    (r.test_title || '').toLowerCase().includes(q) ||
    (r.topics || '').toLowerCase().includes(q)
  );
  renderTableRows(filtered);
}

// ── Boot ──────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', loadDashboard);
</script>
</body>
</html>
