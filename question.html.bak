<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Question Uploader</title>

  <!-- Clean UI styling -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --navy-900: #04111f;
      --navy-800: #071b30;
      --navy-700: #0c2444;
      --navy-600: #112d55;
      --gold-500: #c9a84c;
      --gold-400: #d4b56a;
      --gold-300: #e2cc92;
      --gold-glow: rgba(201,168,76,0.14);
      --border-gold: rgba(201,168,76,0.28);
      --text-primary: #f0ece3;
      --text-secondary: #c8bfb2;
      --text-muted: #8a8070;
      --card: rgba(7, 27, 48, 0.85);
      --radius-xl: 20px;
      --radius-lg: 16px;
      --radius-md: 12px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
    
    body {
      background: var(--navy-900);
      background-image: 
        radial-gradient(ellipse 80% 60% at 20% 10%, rgba(201,168,76,0.07), transparent),
        radial-gradient(ellipse 60% 50% at 80% 85%, rgba(12,36,68,0.6), transparent);
      color: var(--text-primary);
      min-height: 100vh;
      margin: 40px auto;
      max-width: 1000px;
      padding: 0 20px;
      color-scheme: dark;
    }

    h1 {
      font-size: 32px;
      font-weight: 700;
      margin-bottom: 8px;
      background: linear-gradient(135deg, #f0e3bc 0%, #c9a84c 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      letter-spacing: -0.5px;
    }

    p { color: var(--text-secondary); font-size: 16px; margin-bottom: 30px; font-weight: 300; }
    
    .card { 
      background: var(--card); 
      padding: 32px; 
      border-radius: var(--radius-xl); 
      border: 1px solid var(--border-gold);
      box-shadow: 0 20px 50px rgba(0,0,0,0.4); 
      margin-bottom: 30px; 
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
    
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px; }
    .form-group { display: flex; flex-direction: column; gap: 8px; }
    
    label { font-weight: 500; font-size: 14px; color: var(--gold-400); letter-spacing: 0.5px; text-transform: uppercase; }
    label span { color: #ef4444; }
    
    select, input, textarea { 
      width: 100%; 
      padding: 14px 16px; 
      background: rgba(4, 17, 31, 0.6); 
      border: 1px solid var(--border-gold); 
      border-radius: var(--radius-md); 
      color: var(--text-primary); 
      font-size: 15px;
      transition: all 0.2s ease;
    }
    
    select:focus, textarea:focus, input:focus { 
      outline: none; 
      border-color: var(--gold-400); 
      box-shadow: 0 0 0 3px var(--gold-glow); 
      background: var(--navy-800);
    }
    
    select:disabled { opacity: 0.5; cursor: not-allowed; }
    select option { background: var(--navy-800); color: var(--text-primary); }
    
    textarea {
      height: 400px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 14px;
      line-height: 1.6;
      resize: vertical;
    }
    
    textarea::placeholder { color: var(--text-muted); }
    
    .row { display: flex; gap: 16px; align-items: center; margin-top: 24px; flex-wrap: wrap; }
    
    button {
      padding: 12px 24px; 
      border-radius: var(--radius-md); 
      border: none; 
      font-weight: 600; 
      cursor: pointer; 
      font-size: 15px; 
      transition: all 0.2s ease;
      letter-spacing: 0.5px;
    }
    
    .btn-primary { 
      background: linear-gradient(135deg, var(--gold-500) 0%, #b49138 100%);
      color: var(--navy-900); 
      box-shadow: 0 4px 15px var(--gold-glow);
    }
    .btn-primary:hover:not(:disabled) { 
      transform: translateY(-2px); 
      box-shadow: 0 6px 20px rgba(201,168,76,0.3);
    }
    
    .btn-secondary { 
      background: rgba(255,255,255,0.05); 
      color: var(--text-primary); 
      border: 1px solid rgba(255,255,255,0.1); 
    }
    .btn-secondary:hover:not(:disabled) { 
      background: rgba(255,255,255,0.1); 
    }
    
    .btn-danger { 
      background: rgba(239, 68, 68, 0.1); 
      color: #fca5a5; 
      border: 1px solid rgba(239, 68, 68, 0.2); 
      padding: 8px 16px; 
      font-size: 13px;
    }
    .btn-danger:hover:not(:disabled) { 
      background: rgba(239, 68, 68, 0.2); 
      color: #fff;
    }
    
    button:disabled { opacity: 0.5; cursor: not-allowed; }
    
    .hint { 
      font-size: 14px; 
      color: var(--text-secondary); 
      background: rgba(4, 17, 31, 0.5); 
      padding: 16px; 
      border-radius: var(--radius-md); 
      border-left: 3px solid var(--gold-500); 
      margin-bottom: 24px; 
      line-height: 1.6;
    }
    .hint strong { color: var(--gold-400); font-weight: 600; }
    .hint code { 
      background: var(--navy-700); 
      padding: 2px 6px; 
      border-radius: 4px; 
      color: #93c5fd; 
      font-size: 13px;
      font-family: ui-monospace, monospace;
    }
    
    .progress-log {
      margin-top: 24px; 
      max-height: 300px; 
      overflow-y: auto; 
      background: var(--navy-900); 
      border: 1px solid rgba(255,255,255,0.05);
      color: var(--text-secondary); 
      padding: 16px; 
      border-radius: var(--radius-md); 
      font-family: ui-monospace, monospace; 
      font-size: 13px; 
      display: none; 
      line-height: 1.6;
    }
    .progress-log div { margin-bottom: 6px; padding-bottom: 6px; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .progress-log div:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
    .log-success { color: #4ade80 !important; }
    .log-error { color: #f87171 !important; }
    .log-warn { color: #fbbf24 !important; }
    
    /* Manage Section Overrides */
    h2 { font-size: 20px; font-weight: 600; color: var(--gold-400); margin: 0; }
    #manageSection p { color: var(--text-muted); margin-bottom: 20px; }
    
    #bulkActions {
      background: rgba(4, 17, 31, 0.6) !important;
      border: 1px solid var(--border-gold);
      padding: 16px 20px !important;
      border-radius: var(--radius-md) !important;
    }
    
    .question-card { 
      background: rgba(4, 17, 31, 0.4); 
      padding: 20px; 
      border-radius: var(--radius-md); 
      border: 1px solid var(--border-gold); 
      display: flex; 
      align-items: flex-start;
      transition: all 0.2s ease;
    }
    .question-card:hover { border-color: var(--gold-500); background: rgba(4, 17, 31, 0.7); }
    
    .question-stem { font-weight: 500; font-size: 16px; margin-bottom: 12px; color: var(--text-primary); white-space: pre-wrap; line-height: 1.5; }
    .question-options { font-size: 14px; color: var(--text-secondary); line-height: 1.8; }
    
    .q-checkbox {
      accent-color: var(--gold-500);
      width: 18px !important;
      height: 18px !important;
      margin-top: 2px;
      cursor: pointer;
    }
    
    /* Custom Scrollbar for Textarea and Logs */
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--navy-700); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--gold-500); }
</style>



  <!-- Supabase & DOCX libraries -->
  <script src="js/supabase.min.js"></script>
  <script src="js/supabase-config.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/docx@8.5.0/build/index.umd.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>
</head>

<body>
  <h1>Question Uploader & Editor</h1>
  <p>Format questions, assign them to a subject/topic, and <b>POST</b> them directly to the test bank.</p>

  <div class="card">
    <div class="form-grid">
      <div class="form-group">
        <label for="subjectSelect">Subject <span style="color:red">*</span></label>
        <select id="subjectSelect" disabled>
          <option value="">Loading subjects...</option>
        </select>
      </div>
      <div class="form-group">
        <label for="topicSelect">Topic <span style="color:red">*</span></label>
        <select id="topicSelect" disabled>
          <option value="">Select a subject first</option>
        </select>
      </div>
    </div>

    <div class="hint">
      <strong>Format Requirements:</strong> Separate blocks with a blank line.<br>
      Options must start with <code>A.</code>, <code>B)</code>, etc.<br>
      Mark correct option by prefixing with <code>*</code> (e.g. <code>*B. Paris</code>) OR add <code>Correct Answer: B</code> below the options.<br>
      Optionally add <code>Rationale: ...</code> at the end of the block.
    </div>

    <textarea id="src" placeholder="Copy & Paste your questions here...&#10;&#10;1. What is the normal range for Potassium?&#10;A. 1.0 - 2.5 mEq/L&#10;*B. 3.5 - 5.0 mEq/L&#10;C. 5.5 - 7.0 mEq/L&#10;D. 7.5 - 9.0 mEq/L&#10;Rationale: Normal serum potassium is 3.5 to 5.0 mEq/L."></textarea>

    <div class="row">
      <button id="postBtn" class="btn-primary" disabled>POST to Database</button>
      <button id="testBtn" class="btn-secondary">Test Parsing</button>
      <button id="exportBtn" class="btn-secondary">Export to DOCX</button>
    </div>


    <div id="log" class="progress-log"></div>
  </div>

  <div id="manageSection" style="display: none; margin-bottom: 40px;" class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-gold); padding-bottom: 12px; margin-bottom: 16px;">
      <h2 style="margin: 0; font-size: 20px; color: var(--gold-400);">Manage Existing Questions</h2>
      <button id="refreshBtn" class="btn-secondary" style="padding: 6px 12px; font-size: 13px;">Refresh List</button>
    </div>
    <p id="manageCount" style="color: var(--text-muted); font-size: 14px; margin-bottom: 16px;">Loading...</p>
    <div id="bulkActions" style="display: none; align-items: center; gap: 12px; margin-bottom: 12px; padding: 12px; background: var(--navy-800); border: 1px solid var(--border-gold); border-radius: var(--radius-md);">
      <label style="display: flex; align-items: center; gap: 8px; margin: 0; cursor: pointer; font-size: 14px;">
        <input type="checkbox" id="selectAllCheckbox" class="q-checkbox"> <b style="color: var(--text-primary);">Select All</b>
      </label>
      <button id="bulkDeleteBtn" class="btn-danger" style="margin-left: auto;" disabled>Delete Selected (0)</button>
    </div>
    <div id="questionsList" style="display: flex; flex-direction: column; gap: 12px;"></div>
  </div>

  <script>
    // ============================================
    // INITIALIZATION & STATE
    // ============================================
    let db = null;
    let subjectsData = [];
    let topicsData = [];
    let configsData = [];

        const els = {
      subject: document.getElementById('subjectSelect'),
      topic: document.getElementById('topicSelect'),
      src: document.getElementById('src'),
      postBtn: document.getElementById('postBtn'),
      testBtn: document.getElementById('testBtn'),
      exportBtn: document.getElementById('exportBtn'),
      log: document.getElementById('log'),
      manageSection: document.getElementById('manageSection'),
      questionsList: document.getElementById('questionsList'),
      manageCount: document.getElementById('manageCount'),
      refreshBtn: document.getElementById('refreshBtn'),
      bulkActions: document.getElementById('bulkActions'),
      selectAllCheckbox: document.getElementById('selectAllCheckbox'),
      bulkDeleteBtn: document.getElementById('bulkDeleteBtn'),
      bulkActions: document.getElementById('bulkActions'),
      selectAllCheckbox: document.getElementById('selectAllCheckbox'),
      bulkDeleteBtn: document.getElementById('bulkDeleteBtn')
    };

    function logMessage(msg, type = '') {
      els.log.style.display = 'block';
      const div = document.createElement('div');
      div.textContent = `> ${msg}`;
      if (type) div.className = `log-${type}`;
      els.log.appendChild(div);
      els.log.scrollTop = els.log.scrollHeight;
    }

    async function init() {
      try {
        db = typeof initSupabase === 'function' ? initSupabase() : null;
        if (!db) {
          throw new Error('Supabase client failed to initialize. Check js/supabase-config.js');
        }

        els.subject.innerHTML = '<option value="">Loading...</option>';

        const [
          { data: sData, error: sErr },
          { data: tData, error: tErr },
          { data: cData, error: cErr }
        ] = await Promise.all([
          db.from('test_subjects').select('id, name').eq('is_active', true).order('display_order'),
          db.from('test_topics').select('id, subject_id, name').order('display_order'),
          db.from('test_configs').select('id, subject_id')
        ]);

        if (sErr) throw sErr;
        if (tErr) throw tErr;
        if (cErr) throw cErr;

        subjectsData = sData || [];
        topicsData = tData || [];
        configsData = cData || [];

        populateSubjects();
      } catch (err) {
        logMessage(`Initialization Error: ${err.message}`, 'error');
        els.subject.innerHTML = '<option value="">Error loading data</option>';
      }
    }

    function populateSubjects() {
      els.subject.innerHTML = '<option value="">-- Select Subject --</option>';
      subjectsData.forEach(s => {
        const opt = document.createElement('option');
        opt.value = s.id;
        opt.textContent = s.name;
        els.subject.appendChild(opt);
      });
      els.subject.disabled = false;
      els.postBtn.disabled = false;
    }


    
    
    async function loadTopicQuestions() {
      const topicId = els.topic.value;
      if (!topicId) {
        els.manageSection.style.display = 'none';
        return;
      }
      
      els.manageSection.style.display = 'block';
      els.questionsList.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-muted);">Loading questions...</div>';
      els.manageCount.textContent = 'Fetching...';
      
      try {
        const { data, error } = await db
          .from('test_questions')
          .select('id, question_stem, options, correct_answers, rationale, display_order')
          .eq('topic_id', topicId)
          .order('display_order', { ascending: true });
          
        if (error) throw error;
        
        els.manageCount.textContent = data.length + ' questions found in this topic.';
        els.questionsList.innerHTML = '';
        
        if (data.length === 0) {
          els.questionsList.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-muted); background: rgba(4, 17, 31, 0.4); border-radius: 8px; border: 1px dashed var(--border-gold);">No questions currently uploaded for this topic.</div>';
          if (els.bulkActions) els.bulkActions.style.display = 'none';
          return;
        }
        
        data.forEach((q, idx) => {
          const card = document.createElement('div');
          card.className = 'question-card';
          
          const getOptText = (opts) => {
            if (!Array.isArray(opts)) return '';
            return opts.map(o => {
               const isCorrect = Array.isArray(q.correct_answers) && q.correct_answers.includes(o.id.toLowerCase());
               return `<div style="${isCorrect ? 'color: #4ade80; font-weight: 600;' : ''}">${o.id.toUpperCase()}. ${o.text} ${isCorrect ? '✓' : ''}</div>`;
            }).join('');
          };

          card.innerHTML = `
            <div style="margin-right: 16px; padding-top: 2px;">
                <input type="checkbox" class="q-checkbox" value="${q.id}" style="width: 18px; height: 18px; cursor: pointer;">
            </div>
            <div class="question-content" style="flex: 1;">
              <div class="question-stem">${idx + 1}. ${q.question_stem}</div>
              <div class="question-options">
                ${getOptText(q.options)}
              </div>
              ${q.rationale ? `<div style="margin-top: 8px; font-size: 13px; color: var(--text-muted);"><em>Rationale: ${q.rationale}</em></div>` : ''}
            </div>
            <button class="btn-danger" style="margin-left: 16px;" onclick="deleteQuestion('${q.id}')">Delete</button>
          `;
          els.questionsList.appendChild(card);
        });
        
        if (els.bulkActions) els.bulkActions.style.display = 'flex';
        if (els.selectAllCheckbox) els.selectAllCheckbox.checked = false;
        if (window.updateBulkBtn) window.updateBulkBtn();
        
        document.querySelectorAll('.q-checkbox').forEach(cb => cb.addEventListener('change', window.updateBulkBtn));
        
      } catch (err) {
        logMessage('Error loading questions: ' + err.message, 'error');
        els.questionsList.innerHTML = '<div style="color: red;">Failed to load questions. See log.</div>';
      }
    }

    els.topic.addEventListener('change', loadTopicQuestions);
    if (els.refreshBtn) els.refreshBtn.addEventListener('click', loadTopicQuestions);
    
    window.deleteQuestion = async function(id) {
       if (!confirm("Are you sure you want to permanently delete this question?")) return;
       try {
         const { error } = await db.from('test_questions').delete().eq('id', id);
         if (error) throw error;
         logMessage("Question deleted successfully.", "success");
         loadTopicQuestions(); // Refresh list
       } catch (err) {
         logMessage("Failed to delete question: " + err.message, "error");
         alert("Delete failed. See log.");
       }
    };

    window.updateBulkBtn = () => {
      if (!els.bulkDeleteBtn) return;
      const checkedBoxes = document.querySelectorAll('.q-checkbox:checked');
      const totalBoxes = document.querySelectorAll('.q-checkbox');
      els.bulkDeleteBtn.disabled = checkedBoxes.length === 0;
      els.bulkDeleteBtn.textContent = `Delete Selected (${checkedBoxes.length})`;
      if (els.selectAllCheckbox) els.selectAllCheckbox.checked = (checkedBoxes.length > 0 && checkedBoxes.length === totalBoxes.length);
    };

    if (els.selectAllCheckbox) {
      els.selectAllCheckbox.addEventListener('change', (e) => {
        const checkboxes = document.querySelectorAll('.q-checkbox');
        checkboxes.forEach(cb => cb.checked = e.target.checked);
        window.updateBulkBtn();
      });
    }

    if (els.bulkDeleteBtn) {
      els.bulkDeleteBtn.addEventListener('click', async () => {
        const checkedBoxes = document.querySelectorAll('.q-checkbox:checked');
        const ids = Array.from(checkedBoxes).map(cb => cb.value);
        if (ids.length === 0) return;
        if (!confirm(`Are you sure you want to completely delete ${ids.length} questions?`)) return;
        
        els.bulkDeleteBtn.disabled = true;
        els.bulkDeleteBtn.textContent = 'Deleting...';
        
        try {
          const { error } = await db.from('test_questions').delete().in('id', ids);
          if (error) throw error;
          logMessage(`Bulk deleted ${ids.length} questions.`, "success");
          loadTopicQuestions();
        } catch(err) {
          logMessage("Bulk delete failed: " + err.message, "error");
          alert("Delete failed. See log.");
          els.bulkDeleteBtn.disabled = false;
        }
      });
    }
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Question Uploader</title>

  <!-- Clean UI styling -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --navy-900: #04111f;
      --navy-800: #071b30;
      --navy-700: #0c2444;
      --navy-600: #112d55;
      --gold-500: #c9a84c;
      --gold-400: #d4b56a;
      --gold-300: #e2cc92;
      --gold-glow: rgba(201,168,76,0.14);
      --border-gold: rgba(201,168,76,0.28);
      --text-primary: #f0ece3;
      --text-secondary: #c8bfb2;
      --text-muted: #8a8070;
      --card: rgba(7, 27, 48, 0.85);
      --radius-xl: 20px;
      --radius-lg: 16px;
      --radius-md: 12px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
    
    body {
      background: var(--navy-900);
      background-image: 
        radial-gradient(ellipse 80% 60% at 20% 10%, rgba(201,168,76,0.07), transparent),
        radial-gradient(ellipse 60% 50% at 80% 85%, rgba(12,36,68,0.6), transparent);
      color: var(--text-primary);
      min-height: 100vh;
      margin: 40px auto;
      max-width: 1000px;
      padding: 0 20px;
      color-scheme: dark;
    }

    h1 {
      font-size: 32px;
      font-weight: 700;
      margin-bottom: 8px;
      background: linear-gradient(135deg, #f0e3bc 0%, #c9a84c 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      letter-spacing: -0.5px;
    }

    p { color: var(--text-secondary); font-size: 16px; margin-bottom: 30px; font-weight: 300; }
    
    .card { 
      background: var(--card); 
      padding: 32px; 
      border-radius: var(--radius-xl); 
      border: 1px solid var(--border-gold);
      box-shadow: 0 20px 50px rgba(0,0,0,0.4); 
      margin-bottom: 30px; 
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
    
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px; }
    .form-group { display: flex; flex-direction: column; gap: 8px; }
    
    label { font-weight: 500; font-size: 14px; color: var(--gold-400); letter-spacing: 0.5px; text-transform: uppercase; }
    label span { color: #ef4444; }
    
    select, input, textarea { 
      width: 100%; 
      padding: 14px 16px; 
      background: rgba(4, 17, 31, 0.6); 
      border: 1px solid var(--border-gold); 
      border-radius: var(--radius-md); 
      color: var(--text-primary); 
      font-size: 15px;
      transition: all 0.2s ease;
    }
    
    select:focus, textarea:focus, input:focus { 
      outline: none; 
      border-color: var(--gold-400); 
      box-shadow: 0 0 0 3px var(--gold-glow); 
      background: var(--navy-800);
    }
    
    select:disabled { opacity: 0.5; cursor: not-allowed; }
    select option { background: var(--navy-800); color: var(--text-primary); }
    
    textarea {
      height: 400px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 14px;
      line-height: 1.6;
      resize: vertical;
    }
    
    textarea::placeholder { color: var(--text-muted); }
    
    .row { display: flex; gap: 16px; align-items: center; margin-top: 24px; flex-wrap: wrap; }
    
    button {
      padding: 12px 24px; 
      border-radius: var(--radius-md); 
      border: none; 
      font-weight: 600; 
      cursor: pointer; 
      font-size: 15px; 
      transition: all 0.2s ease;
      letter-spacing: 0.5px;
    }
    
    .btn-primary { 
      background: linear-gradient(135deg, var(--gold-500) 0%, #b49138 100%);
      color: var(--navy-900); 
      box-shadow: 0 4px 15px var(--gold-glow);
    }
    .btn-primary:hover:not(:disabled) { 
      transform: translateY(-2px); 
      box-shadow: 0 6px 20px rgba(201,168,76,0.3);
    }
    
    .btn-secondary { 
      background: rgba(255,255,255,0.05); 
      color: var(--text-primary); 
      border: 1px solid rgba(255,255,255,0.1); 
    }
    .btn-secondary:hover:not(:disabled) { 
      background: rgba(255,255,255,0.1); 
    }
    
    .btn-danger { 
      background: rgba(239, 68, 68, 0.1); 
      color: #fca5a5; 
      border: 1px solid rgba(239, 68, 68, 0.2); 
      padding: 8px 16px; 
      font-size: 13px;
    }
    .btn-danger:hover:not(:disabled) { 
      background: rgba(239, 68, 68, 0.2); 
      color: #fff;
    }
    
    button:disabled { opacity: 0.5; cursor: not-allowed; }
    
    .hint { 
      font-size: 14px; 
      color: var(--text-secondary); 
      background: rgba(4, 17, 31, 0.5); 
      padding: 16px; 
      border-radius: var(--radius-md); 
      border-left: 3px solid var(--gold-500); 
      margin-bottom: 24px; 
      line-height: 1.6;
    }
    .hint strong { color: var(--gold-400); font-weight: 600; }
    .hint code { 
      background: var(--navy-700); 
      padding: 2px 6px; 
      border-radius: 4px; 
      color: #93c5fd; 
      font-size: 13px;
      font-family: ui-monospace, monospace;
    }
    
    .progress-log {
      margin-top: 24px; 
      max-height: 300px; 
      overflow-y: auto; 
      background: var(--navy-900); 
      border: 1px solid rgba(255,255,255,0.05);
      color: var(--text-secondary); 
      padding: 16px; 
      border-radius: var(--radius-md); 
      font-family: ui-monospace, monospace; 
      font-size: 13px; 
      display: none; 
      line-height: 1.6;
    }
    .progress-log div { margin-bottom: 6px; padding-bottom: 6px; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .progress-log div:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
    .log-success { color: #4ade80 !important; }
    .log-error { color: #f87171 !important; }
    .log-warn { color: #fbbf24 !important; }
    
    /* Manage Section Overrides */
    h2 { font-size: 20px; font-weight: 600; color: var(--gold-400); margin: 0; }
    #manageSection p { color: var(--text-muted); margin-bottom: 20px; }
    
    #bulkActions {
      background: rgba(4, 17, 31, 0.6) !important;
      border: 1px solid var(--border-gold);
      padding: 16px 20px !important;
      border-radius: var(--radius-md) !important;
    }
    
    .question-card { 
      background: rgba(4, 17, 31, 0.4); 
      padding: 20px; 
      border-radius: var(--radius-md); 
      border: 1px solid var(--border-gold); 
      display: flex; 
      align-items: flex-start;
      transition: all 0.2s ease;
    }
    .question-card:hover { border-color: var(--gold-500); background: rgba(4, 17, 31, 0.7); }
    
    .question-stem { font-weight: 500; font-size: 16px; margin-bottom: 12px; color: var(--text-primary); white-space: pre-wrap; line-height: 1.5; }
    .question-options { font-size: 14px; color: var(--text-secondary); line-height: 1.8; }
    
    .q-checkbox {
      accent-color: var(--gold-500);
      width: 18px !important;
      height: 18px !important;
      margin-top: 2px;
      cursor: pointer;
    }
    
    /* Custom Scrollbar for Textarea and Logs */
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--navy-700); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--gold-500); }
</style>



  <!-- Supabase & DOCX libraries -->
  <script src="js/supabase.min.js"></script>
  <script src="js/supabase-config.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/docx@8.5.0/build/index.umd.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>
</head>

<body>
  <h1>Question Uploader & Editor</h1>
  <p>Format questions, assign them to a subject/topic, and <b>POST</b> them directly to the test bank.</p>

  <div class="card">
    <div class="form-grid">
      <div class="form-group">
        <label for="subjectSelect">Subject <span style="color:red">*</span></label>
        <select id="subjectSelect" disabled>
          <option value="">Loading subjects...</option>
        </select>
      </div>
      <div class="form-group">
        <label for="topicSelect">Topic <span style="color:red">*</span></label>
        <select id="topicSelect" disabled>
          <option value="">Select a subject first</option>
        </select>
      </div>
    </div>

    <div class="hint">
      <strong>Format Requirements:</strong> Separate blocks with a blank line.<br>
      Options must start with <code>A.</code>, <code>B)</code>, etc.<br>
      Mark correct option by prefixing with <code>*</code> (e.g. <code>*B. Paris</code>) OR add <code>Correct Answer: B</code> below the options.<br>
      Optionally add <code>Rationale: ...</code> at the end of the block.
    </div>

    <textarea id="src" placeholder="Copy & Paste your questions here...&#10;&#10;1. What is the normal range for Potassium?&#10;A. 1.0 - 2.5 mEq/L&#10;*B. 3.5 - 5.0 mEq/L&#10;C. 5.5 - 7.0 mEq/L&#10;D. 7.5 - 9.0 mEq/L&#10;Rationale: Normal serum potassium is 3.5 to 5.0 mEq/L."></textarea>

    <div class="row">
      <button id="postBtn" class="btn-primary" disabled>POST to Database</button>
      <button id="testBtn" class="btn-secondary">Test Parsing</button>
      <button id="exportBtn" class="btn-secondary">Export to DOCX</button>
    </div>


    <div id="log" class="progress-log"></div>
  </div>

  <div id="manageSection" style="display: none; margin-bottom: 40px;" class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-gold); padding-bottom: 12px; margin-bottom: 16px;">
      <h2 style="margin: 0; font-size: 20px; color: var(--gold-400);">Manage Existing Questions</h2>
      <button id="refreshBtn" class="btn-secondary" style="padding: 6px 12px; font-size: 13px;">Refresh List</button>
    </div>
    <p id="manageCount" style="color: var(--text-muted); font-size: 14px; margin-bottom: 16px;">Loading...</p>
    <div id="bulkActions" style="display: none; align-items: center; gap: 12px; margin-bottom: 12px; padding: 12px; background: var(--navy-800); border: 1px solid var(--border-gold); border-radius: var(--radius-md);">
      <label style="display: flex; align-items: center; gap: 8px; margin: 0; cursor: pointer; font-size: 14px;">
        <input type="checkbox" id="selectAllCheckbox" class="q-checkbox"> <b style="color: var(--text-primary);">Select All</b>
      </label>
      <button id="bulkDeleteBtn" class="btn-danger" style="margin-left: auto;" disabled>Delete Selected (0)</button>
    </div>
    <div id="questionsList" style="display: flex; flex-direction: column; gap: 12px;"></div>
  </div>

  <script>
    // ============================================
    // INITIALIZATION & STATE
    // ============================================
    let db = null;
    let subjectsData = [];
    let topicsData = [];
    let configsData = [];

        const els = {
      subject: document.getElementById('subjectSelect'),
      topic: document.getElementById('topicSelect'),
      src: document.getElementById('src'),
      postBtn: document.getElementById('postBtn'),
      testBtn: document.getElementById('testBtn'),
      exportBtn: document.getElementById('exportBtn'),
      log: document.getElementById('log'),
      manageSection: document.getElementById('manageSection'),
      questionsList: document.getElementById('questionsList'),
      manageCount: document.getElementById('manageCount'),
      refreshBtn: document.getElementById('refreshBtn'),
      bulkActions: document.getElementById('bulkActions'),
      selectAllCheckbox: document.getElementById('selectAllCheckbox'),
      bulkDeleteBtn: document.getElementById('bulkDeleteBtn'),
      bulkActions: document.getElementById('bulkActions'),
      selectAllCheckbox: document.getElementById('selectAllCheckbox'),
      bulkDeleteBtn: document.getElementById('bulkDeleteBtn')
    };

    function logMessage(msg, type = '') {
      els.log.style.display = 'block';
      const div = document.createElement('div');
      div.textContent = `> ${msg}`;
      if (type) div.className = `log-${type}`;
      els.log.appendChild(div);
      els.log.scrollTop = els.log.scrollHeight;
    }

    async function init() {
      try {
        db = typeof initSupabase === 'function' ? initSupabase() : null;
        if (!db) {
          throw new Error('Supabase client failed to initialize. Check js/supabase-config.js');
        }

        els.subject.innerHTML = '<option value="">Loading...</option>';

        const [
          { data: sData, error: sErr },
          { data: tData, error: tErr },
          { data: cData, error: cErr }
        ] = await Promise.all([
          db.from('test_subjects').select('id, name').eq('is_active', true).order('display_order'),
          db.from('test_topics').select('id, subject_id, name').order('display_order'),
          db.from('test_configs').select('id, subject_id')
        ]);

        if (sErr) throw sErr;
        if (tErr) throw tErr;
        if (cErr) throw cErr;

        subjectsData = sData || [];
        topicsData = tData || [];
        configsData = cData || [];

        populateSubjects();
      } catch (err) {
        logMessage(`Initialization Error: ${err.message}`, 'error');
        els.subject.innerHTML = '<option value="">Error loading data</option>';
      }
    }

    function populateSubjects() {
      els.subject.innerHTML = '<option value="">-- Select Subject --</option>';
      subjectsData.forEach(s => {
        const opt = document.createElement('option');
        opt.value = s.id;
        opt.textContent = s.name;
        els.subject.appendChild(opt);
      });
      els.subject.disabled = false;
      els.postBtn.disabled = false;
    }


    
    async function loadTopicQuestions() {
      const topicId = els.topic.value;
      if (!topicId) {
        els.manageSection.style.display = 'none';
        return;
      }
      
      els.manageSection.style.display = 'block';
      els.questionsList.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-muted);">Loading questions...</div>';
      els.manageCount.textContent = 'Fetching...';
      
      try {
        const { data, error } = await db
          .from('test_questions')
          .select('id, question_stem, options, correct_answers, rationale, display_order')
          .eq('topic_id', topicId)
          .order('display_order', { ascending: true });
          
        if (error) throw error;
        
        els.manageCount.textContent = data.length + ' questions found in this topic.';
        els.questionsList.innerHTML = '';
        
        if (data.length === 0) {
          els.questionsList.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-muted); background: rgba(4, 17, 31, 0.4); border-radius: 8px; border: 1px dashed var(--border-gold);">No questions currently uploaded for this topic.</div>';
          if (els.bulkActions) els.bulkActions.style.display = 'none';
          return;
        }
        
        data.forEach((q, idx) => {
          const card = document.createElement('div');
          card.className = 'question-card';
          
          const getOptText = (opts) => {
            if (!Array.isArray(opts)) return '';
            return opts.map(o => {
               const isCorrect = Array.isArray(q.correct_answers) && q.correct_answers.includes(o.id.toLowerCase());
               return `<div style="${isCorrect ? 'color: #4ade80; font-weight: 600;' : ''}">${o.id.toUpperCase()}. ${o.text} ${isCorrect ? '✓' : ''}</div>`;
            }).join('');
          };

          card.innerHTML = `
            <div style="margin-right: 16px; padding-top: 2px;">
                <input type="checkbox" class="q-checkbox" value="${q.id}" style="width: 18px; height: 18px; cursor: pointer;">
            </div>
            <div class="question-content" style="flex: 1;">
              <div class="question-stem">${idx + 1}. ${q.question_stem}</div>
              <div class="question-options">
                ${getOptText(q.options)}
              </div>
              ${q.rationale ? `<div style="margin-top: 8px; font-size: 13px; color: var(--text-muted);"><em>Rationale: ${q.rationale}</em></div>` : ''}
            </div>
            <button class="btn-danger" style="margin-left: 16px;" onclick="deleteQuestion('${q.id}')">Delete</button>
          `;
          els.questionsList.appendChild(card);
        });
        
        if (els.bulkActions) els.bulkActions.style.display = 'flex';
        if (els.selectAllCheckbox) els.selectAllCheckbox.checked = false;
        if (window.updateBulkBtn) window.updateBulkBtn();
        
        document.querySelectorAll('.q-checkbox').forEach(cb => cb.addEventListener('change', window.updateBulkBtn));
        
      } catch (err) {
        logMessage('Error loading questions: ' + err.message, 'error');
        els.questionsList.innerHTML = '<div style="color: red;">Failed to load questions. See log.</div>';
      }
    }

    els.topic.addEventListener('change', loadTopicQuestions);
    if (els.refreshBtn) els.refreshBtn.addEventListener('click', loadTopicQuestions);
    
    window.deleteQuestion = async function(id) {
       if (!confirm("Are you sure you want to permanently delete this question?")) return;
       try {
         const { error } = await db.from('test_questions').delete().eq('id', id);
         if (error) throw error;
         logMessage("Question deleted successfully.", "success");
         loadTopicQuestions(); // Refresh list
       } catch (err) {
         logMessage("Failed to delete question: " + err.message, "error");
         alert("Delete failed. See log.");
       }
    };

    window.updateBulkBtn = () => {
      if (!els.bulkDeleteBtn) return;
      const checkedBoxes = document.querySelectorAll('.q-checkbox:checked');
      const totalBoxes = document.querySelectorAll('.q-checkbox');
      els.bulkDeleteBtn.disabled = checkedBoxes.length === 0;
      els.bulkDeleteBtn.textContent = `Delete Selected (${checkedBoxes.length})`;
      if (els.selectAllCheckbox) els.selectAllCheckbox.checked = (checkedBoxes.length > 0 && checkedBoxes.length === totalBoxes.length);
    };

    if (els.selectAllCheckbox) {
      els.selectAllCheckbox.addEventListener('change', (e) => {
        const checkboxes = document.querySelectorAll('.q-checkbox');
        checkboxes.forEach(cb => cb.checked = e.target.checked);
        window.updateBulkBtn();
      });
    }

    if (els.bulkDeleteBtn) {
      els.bulkDeleteBtn.addEventListener('click', async () => {
        const checkedBoxes = document.querySelectorAll('.q-checkbox:checked');
        const ids = Array.from(checkedBoxes).map(cb => cb.value);
        if (ids.length === 0) return;
        if (!confirm(`Are you sure you want to completely delete ${ids.length} questions?`)) return;
        
        els.bulkDeleteBtn.disabled = true;
        els.bulkDeleteBtn.textContent = 'Deleting...';
        
        try {
          const { error } = await db.from('test_questions').delete().in('id', ids);
          if (error) throw error;
          logMessage(`Bulk deleted ${ids.length} questions.`, "success");
          loadTopicQuestions();
        } catch(err) {
          logMessage("Bulk delete failed: " + err.message, "error");
          alert("Delete failed. See log.");
          els.bulkDeleteBtn.disabled = false;
        }
      });
    }
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Question Uploader</title>

  <!-- Clean UI styling -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --navy-900: #04111f;
      --navy-800: #071b30;
      --navy-700: #0c2444;
      --navy-600: #112d55;
      --gold-500: #c9a84c;
      --gold-400: #d4b56a;
      --gold-300: #e2cc92;
      --gold-glow: rgba(201,168,76,0.14);
      --border-gold: rgba(201,168,76,0.28);
      --text-primary: #f0ece3;
      --text-secondary: #c8bfb2;
      --text-muted: #8a8070;
      --card: rgba(7, 27, 48, 0.85);
      --radius-xl: 20px;
      --radius-lg: 16px;
      --radius-md: 12px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
    
    body {
      background: var(--navy-900);
      background-image: 
        radial-gradient(ellipse 80% 60% at 20% 10%, rgba(201,168,76,0.07), transparent),
        radial-gradient(ellipse 60% 50% at 80% 85%, rgba(12,36,68,0.6), transparent);
      color: var(--text-primary);
      min-height: 100vh;
      margin: 40px auto;
      max-width: 1000px;
      padding: 0 20px;
      color-scheme: dark;
    }

    h1 {
      font-size: 32px;
      font-weight: 700;
      margin-bottom: 8px;
      background: linear-gradient(135deg, #f0e3bc 0%, #c9a84c 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      letter-spacing: -0.5px;
    }

    p { color: var(--text-secondary); font-size: 16px; margin-bottom: 30px; font-weight: 300; }
    
    .card { 
      background: var(--card); 
      padding: 32px; 
      border-radius: var(--radius-xl); 
      border: 1px solid var(--border-gold);
      box-shadow: 0 20px 50px rgba(0,0,0,0.4); 
      margin-bottom: 30px; 
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
    
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px; }
    .form-group { display: flex; flex-direction: column; gap: 8px; }
    
    label { font-weight: 500; font-size: 14px; color: var(--gold-400); letter-spacing: 0.5px; text-transform: uppercase; }
    label span { color: #ef4444; }
    
    select, input, textarea { 
      width: 100%; 
      padding: 14px 16px; 
      background: rgba(4, 17, 31, 0.6); 
      border: 1px solid var(--border-gold); 
      border-radius: var(--radius-md); 
      color: var(--text-primary); 
      font-size: 15px;
      transition: all 0.2s ease;
    }
    
    select:focus, textarea:focus, input:focus { 
      outline: none; 
      border-color: var(--gold-400); 
      box-shadow: 0 0 0 3px var(--gold-glow); 
      background: var(--navy-800);
    }
    
    select:disabled { opacity: 0.5; cursor: not-allowed; }
    select option { background: var(--navy-800); color: var(--text-primary); }
    
    textarea {
      height: 400px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 14px;
      line-height: 1.6;
      resize: vertical;
    }
    
    textarea::placeholder { color: var(--text-muted); }
    
    .row { display: flex; gap: 16px; align-items: center; margin-top: 24px; flex-wrap: wrap; }
    
    button {
      padding: 12px 24px; 
      border-radius: var(--radius-md); 
      border: none; 
      font-weight: 600; 
      cursor: pointer; 
      font-size: 15px; 
      transition: all 0.2s ease;
      letter-spacing: 0.5px;
    }
    
    .btn-primary { 
      background: linear-gradient(135deg, var(--gold-500) 0%, #b49138 100%);
      color: var(--navy-900); 
      box-shadow: 0 4px 15px var(--gold-glow);
    }
    .btn-primary:hover:not(:disabled) { 
      transform: translateY(-2px); 
      box-shadow: 0 6px 20px rgba(201,168,76,0.3);
    }
    
    .btn-secondary { 
      background: rgba(255,255,255,0.05); 
      color: var(--text-primary); 
      border: 1px solid rgba(255,255,255,0.1); 
    }
    .btn-secondary:hover:not(:disabled) { 
      background: rgba(255,255,255,0.1); 
    }
    
    .btn-danger { 
      background: rgba(239, 68, 68, 0.1); 
      color: #fca5a5; 
      border: 1px solid rgba(239, 68, 68, 0.2); 
      padding: 8px 16px; 
      font-size: 13px;
    }
    .btn-danger:hover:not(:disabled) { 
      background: rgba(239, 68, 68, 0.2); 
      color: #fff;
    }
    
    button:disabled { opacity: 0.5; cursor: not-allowed; }
    
    .hint { 
      font-size: 14px; 
      color: var(--text-secondary); 
      background: rgba(4, 17, 31, 0.5); 
      padding: 16px; 
      border-radius: var(--radius-md); 
      border-left: 3px solid var(--gold-500); 
      margin-bottom: 24px; 
      line-height: 1.6;
    }
    .hint strong { color: var(--gold-400); font-weight: 600; }
    .hint code { 
      background: var(--navy-700); 
      padding: 2px 6px; 
      border-radius: 4px; 
      color: #93c5fd; 
      font-size: 13px;
      font-family: ui-monospace, monospace;
    }
    
    .progress-log {
      margin-top: 24px; 
      max-height: 300px; 
      overflow-y: auto; 
      background: var(--navy-900); 
      border: 1px solid rgba(255,255,255,0.05);
      color: var(--text-secondary); 
      padding: 16px; 
      border-radius: var(--radius-md); 
      font-family: ui-monospace, monospace; 
      font-size: 13px; 
      display: none; 
      line-height: 1.6;
    }
    .progress-log div { margin-bottom: 6px; padding-bottom: 6px; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .progress-log div:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
    .log-success { color: #4ade80 !important; }
    .log-error { color: #f87171 !important; }
    .log-warn { color: #fbbf24 !important; }
    
    /* Manage Section Overrides */
    h2 { font-size: 20px; font-weight: 600; color: var(--gold-400); margin: 0; }
    #manageSection p { color: var(--text-muted); margin-bottom: 20px; }
    
    #bulkActions {
      background: rgba(4, 17, 31, 0.6) !important;
      border: 1px solid var(--border-gold);
      padding: 16px 20px !important;
      border-radius: var(--radius-md) !important;
    }
    
    .question-card { 
      background: rgba(4, 17, 31, 0.4); 
      padding: 20px; 
      border-radius: var(--radius-md); 
      border: 1px solid var(--border-gold); 
      display: flex; 
      align-items: flex-start;
      transition: all 0.2s ease;
    }
    .question-card:hover { border-color: var(--gold-500); background: rgba(4, 17, 31, 0.7); }
    
    .question-stem { font-weight: 500; font-size: 16px; margin-bottom: 12px; color: var(--text-primary); white-space: pre-wrap; line-height: 1.5; }
    .question-options { font-size: 14px; color: var(--text-secondary); line-height: 1.8; }
    
    .q-checkbox {
      accent-color: var(--gold-500);
      width: 18px !important;
      height: 18px !important;
      margin-top: 2px;
      cursor: pointer;
    }
    
    /* Custom Scrollbar for Textarea and Logs */
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--navy-700); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--gold-500); }
</style>



  <!-- Supabase & DOCX libraries -->
  <script src="js/supabase.min.js"></script>
  <script src="js/supabase-config.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/docx@8.5.0/build/index.umd.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>
</head>

<body>
  <h1>Question Uploader & Editor</h1>
  <p>Format questions, assign them to a subject/topic, and <b>POST</b> them directly to the test bank.</p>

  <div class="card">
    <div class="form-grid">
      <div class="form-group">
        <label for="subjectSelect">Subject <span style="color:red">*</span></label>
        <select id="subjectSelect" disabled>
          <option value="">Loading subjects...</option>
        </select>
      </div>
      <div class="form-group">
        <label for="topicSelect">Topic <span style="color:red">*</span></label>
        <select id="topicSelect" disabled>
          <option value="">Select a subject first</option>
        </select>
      </div>
    </div>

    <div class="hint">
      <strong>Format Requirements:</strong> Separate blocks with a blank line.<br>
      Options must start with <code>A.</code>, <code>B)</code>, etc.<br>
      Mark correct option by prefixing with <code>*</code> (e.g. <code>*B. Paris</code>) OR add <code>Correct Answer: B</code> below the options.<br>
      Optionally add <code>Rationale: ...</code> at the end of the block.
    </div>

    <textarea id="src" placeholder="Copy & Paste your questions here...&#10;&#10;1. What is the normal range for Potassium?&#10;A. 1.0 - 2.5 mEq/L&#10;*B. 3.5 - 5.0 mEq/L&#10;C. 5.5 - 7.0 mEq/L&#10;D. 7.5 - 9.0 mEq/L&#10;Rationale: Normal serum potassium is 3.5 to 5.0 mEq/L."></textarea>

    <div class="row">
      <button id="postBtn" class="btn-primary" disabled>POST to Database</button>
      <button id="testBtn" class="btn-secondary">Test Parsing</button>
      <button id="exportBtn" class="btn-secondary">Export to DOCX</button>
    </div>


    <div id="log" class="progress-log"></div>
  </div>

  <div id="manageSection" style="display: none; margin-bottom: 40px;" class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-gold); padding-bottom: 12px; margin-bottom: 16px;">
      <h2 style="margin: 0; font-size: 20px; color: var(--gold-400);">Manage Existing Questions</h2>
      <button id="refreshBtn" class="btn-secondary" style="padding: 6px 12px; font-size: 13px;">Refresh List</button>
    </div>
    <p id="manageCount" style="color: var(--text-muted); font-size: 14px; margin-bottom: 16px;">Loading...</p>
    <div id="bulkActions" style="display: none; align-items: center; gap: 12px; margin-bottom: 12px; padding: 12px; background: var(--navy-800); border: 1px solid var(--border-gold); border-radius: var(--radius-md);">
      <label style="display: flex; align-items: center; gap: 8px; margin: 0; cursor: pointer; font-size: 14px;">
        <input type="checkbox" id="selectAllCheckbox" class="q-checkbox"> <b style="color: var(--text-primary);">Select All</b>
      </label>
      <button id="bulkDeleteBtn" class="btn-danger" style="margin-left: auto;" disabled>Delete Selected (0)</button>
    </div>
    <div id="questionsList" style="display: flex; flex-direction: column; gap: 12px;"></div>
  </div>

  <script>
    // ============================================
    // INITIALIZATION & STATE
    // ============================================
    let db = null;
    let subjectsData = [];
    let topicsData = [];
    let configsData = [];

        const els = {
      subject: document.getElementById('subjectSelect'),
      topic: document.getElementById('topicSelect'),
      src: document.getElementById('src'),
      postBtn: document.getElementById('postBtn'),
      testBtn: document.getElementById('testBtn'),
      exportBtn: document.getElementById('exportBtn'),
      log: document.getElementById('log'),
      manageSection: document.getElementById('manageSection'),
      questionsList: document.getElementById('questionsList'),
      manageCount: document.getElementById('manageCount'),
      refreshBtn: document.getElementById('refreshBtn'),
      bulkActions: document.getElementById('bulkActions'),
      selectAllCheckbox: document.getElementById('selectAllCheckbox'),
      bulkDeleteBtn: document.getElementById('bulkDeleteBtn'),
      bulkActions: document.getElementById('bulkActions'),
      selectAllCheckbox: document.getElementById('selectAllCheckbox'),
      bulkDeleteBtn: document.getElementById('bulkDeleteBtn')
    };

    function logMessage(msg, type = '') {
      els.log.style.display = 'block';
      const div = document.createElement('div');
      div.textContent = `> ${msg}`;
      if (type) div.className = `log-${type}`;
      els.log.appendChild(div);
      els.log.scrollTop = els.log.scrollHeight;
    }

    async function init() {
      try {
        db = typeof initSupabase === 'function' ? initSupabase() : null;
        if (!db) {
          throw new Error('Supabase client failed to initialize. Check js/supabase-config.js');
        }

        els.subject.innerHTML = '<option value="">Loading...</option>';

        const [
          { data: sData, error: sErr },
          { data: tData, error: tErr },
          { data: cData, error: cErr }
        ] = await Promise.all([
          db.from('test_subjects').select('id, name').eq('is_active', true).order('display_order'),
          db.from('test_topics').select('id, subject_id, name').order('display_order'),
          db.from('test_configs').select('id, subject_id')
        ]);

        if (sErr) throw sErr;
        if (tErr) throw tErr;
        if (cErr) throw cErr;

        subjectsData = sData || [];
        topicsData = tData || [];
        configsData = cData || [];

        populateSubjects();
      } catch (err) {
        logMessage(`Initialization Error: ${err.message}`, 'error');
        els.subject.innerHTML = '<option value="">Error loading data</option>';
      }
    }

    function populateSubjects() {
      els.subject.innerHTML = '<option value="">-- Select Subject --</option>';
      subjectsData.forEach(s => {
        const opt = document.createElement('option');
        opt.value = s.id;
        opt.textContent = s.name;
        els.subject.appendChild(opt);
      });
      els.subject.disabled = false;
      els.postBtn.disabled = false;
    }


    async function loadTopicQuestions() {
      const topicId = els.topic.value;
      if (!topicId) {
        els.manageSection.style.display = 'none';
        return;
      }
      
      els.manageSection.style.display = 'block';
      els.questionsList.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-muted);">Loading questions...</div>';
      els.manageCount.textContent = 'Fetching...';
      
      try {
        const { data, error } = await db
          .from('test_questions')
          .select('id, question_stem, options, correct_answers, rationale, display_order')
          .eq('topic_id', topicId)
          .order('display_order', { ascending: true });
          
        if (error) throw error;
        
        els.manageCount.textContent = data.length + ' questions found in this topic.';
        els.questionsList.innerHTML = '';
        
        if (data.length === 0) {
          els.questionsList.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-muted); background: rgba(4, 17, 31, 0.4); border-radius: 8px; border: 1px dashed var(--border-gold);">No questions currently uploaded for this topic.</div>';
          if (els.bulkActions) els.bulkActions.style.display = 'none';
          return;
        }
        
        data.forEach((q, idx) => {
          const card = document.createElement('div');
          card.className = 'question-card';
          
          const getOptText = (opts) => {
            if (!Array.isArray(opts)) return '';
            return opts.map(o => {
               const isCorrect = Array.isArray(q.correct_answers) && q.correct_answers.includes(o.id.toLowerCase());
               return `<div style="${isCorrect ? 'color: #4ade80; font-weight: 600;' : ''}">${o.id.toUpperCase()}. ${o.text} ${isCorrect ? '✓' : ''}</div>`;
            }).join('');
          };

          card.innerHTML = `
            <div style="margin-right: 16px; padding-top: 2px;">
                <input type="checkbox" class="q-checkbox" value="${q.id}" style="width: 18px; height: 18px; cursor: pointer;">
              </div>
              <div class="question-content">
              <div class="question-stem">${idx + 1}. ${q.question_stem}</div>
              <div class="question-options">
                ${getOptText(q.options)}
              </div>
              ${q.rationale ? `<div style="margin-top: 8px; font-size: 12px; color: var(--text-muted);"><em>Rationale: ${q.rationale}</em></div>` : ''}
            </div>
            <button class="btn-danger" onclick="deleteQuestion('${q.id}')">Delete</button>
          `;
          els.questionsList.appendChild(card);
        });
        if (els.bulkActions) els.bulkActions.style.display = 'flex';
        if (els.selectAllCheckbox) els.selectAllCheckbox.checked = false;
        window.window.updateBulkBtn();
        document.querySelectorAll('.q-checkbox').forEach(cb => cb.addEventListener('change', updateBulkBtn));
        if (els.bulkActions) els.bulkActions.style.display = 'flex';
        if (els.selectAllCheckbox) els.selectAllCheckbox.checked = false;
        window.window.updateBulkBtn();
        document.querySelectorAll('.q-checkbox').forEach(cb => cb.addEventListener('change', updateBulkBtn));
      } catch (err) {
        logMessage('Error loading questions: ' + err.message, 'error');
        els.questionsList.innerHTML = '<div style="color: red;">Failed to load questions. See log.</div>';
      }
    }

    els.topic.addEventListener('change', loadTopicQuestions);
    if (els.refreshBtn) els.refreshBtn.addEventListener('click', loadTopicQuestions);
    
    window.deleteQuestion = async function(id) {
       if (!confirm("Are you sure you want to permanently delete this question?")) return;
       
       try {
         const { error } = await db.from('test_questions').delete().eq('id', id);
         if (error) throw error;
         logMessage("Question deleted successfully.", "success");
         loadTopicQuestions(); // Refresh list
       } catch (err) {
         logMessage("Failed to delete question: " + err.message, "error");
         alert("Delete failed. See log.");
       }
    };

    window.updateBulkBtn = () => {
      if (!els.bulkDeleteBtn) return;
      const checkedBoxes = document.querySelectorAll('.q-checkbox:checked');
      const totalBoxes = document.querySelectorAll('.q-checkbox');
      els.bulkDeleteBtn.disabled = checkedBoxes.length === 0;
      els.bulkDeleteBtn.textContent = `Delete Selected (${checkedBoxes.length})`;
      if (els.selectAllCheckbox) els.selectAllCheckbox.checked = checkedBoxes.length > 0 && checkedBoxes.length === totalBoxes.length;
    };

    if (els.selectAllCheckbox) {
      els.selectAllCheckbox.addEventListener('change', (e) => {
        const checkboxes = document.querySelectorAll('.q-checkbox');
        checkboxes.forEach(cb => cb.checked = e.target.checked);
        window.window.updateBulkBtn();
      });
    }

    if (els.bulkDeleteBtn) {
      els.bulkDeleteBtn.addEventListener('click', async () => {
        const checkedBoxes = document.querySelectorAll('.q-checkbox:checked');
        const ids = Array.from(checkedBoxes).map(cb => cb.value);
        if (ids.length === 0) return;
        if (!confirm(`Are you sure you want to completely delete ${ids.length} questions?`)) return;
        
        els.bulkDeleteBtn.disabled = true;
        els.bulkDeleteBtn.textContent = 'Deleting...';
        
        try {
          const { error } = await db.from('test_questions').delete().in('id', ids);
          if (error) throw error;
          logMessage(`Bulk deleted ${ids.length} questions.`, "success");
          loadTopicQuestions();
        } catch(err) {
          logMessage("Bulk delete failed: " + err.message, "error");
          alert("Delete failed. See log.");
          els.bulkDeleteBtn.disabled = false;
        }
      });
    }


    window.updateBulkBtn = () => {
      if (!els.bulkDeleteBtn) return;
      const checkedBoxes = document.querySelectorAll('.q-checkbox:checked');
      const totalBoxes = document.querySelectorAll('.q-checkbox');
      els.bulkDeleteBtn.disabled = checkedBoxes.length === 0;
      els.bulkDeleteBtn.textContent = `Delete Selected (${checkedBoxes.length})`;
      if (els.selectAllCheckbox) els.selectAllCheckbox.checked = checkedBoxes.length > 0 && checkedBoxes.length === totalBoxes.length;
    };

    if (els.selectAllCheckbox) {
      els.selectAllCheckbox.addEventListener('change', (e) => {
        const checkboxes = document.querySelectorAll('.q-checkbox');
        checkboxes.forEach(cb => cb.checked = e.target.checked);
        window.window.updateBulkBtn();
      });
    }

    if (els.bulkDeleteBtn) {
      els.bulkDeleteBtn.addEventListener('click', async () => {
        const checkedBoxes = document.querySelectorAll('.q-checkbox:checked');
        const ids = Array.from(checkedBoxes).map(cb => cb.value);
        if (ids.length === 0) return;
        if (!confirm(`Are you sure you want to completely delete ${ids.length} questions?`)) return;
        
        els.bulkDeleteBtn.disabled = true;
        els.bulkDeleteBtn.textContent = 'Deleting...';
        
        try {
          const { error } = await db.from('test_questions').delete().in('id', ids);
          if (error) throw error;
          logMessage(`Bulk deleted ${ids.length} questions.`, "success");
          loadTopicQuestions();
        } catch(err) {
          logMessage("Bulk delete failed: " + err.message, "error");
          alert("Delete failed. See log.");
          els.bulkDeleteBtn.disabled = false;
        }
      });
    }



    async function loadTopicQuestions() {
      const topicId = els.topic.value;
      if (!topicId) {
        els.manageSection.style.display = 'none';
        return;
      }
      
      els.manageSection.style.display = 'block';
      els.questionsList.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-muted);">Loading questions...</div>';
      els.manageCount.textContent = 'Fetching...';
      
      try {
        const { data, error } = await db
          .from('test_questions')
          .select('id, question_stem, options, correct_answers, rationale, display_order')
          .eq('topic_id', topicId)
          .order('display_order', { ascending: true });
          
        if (error) throw error;
        
        els.manageCount.textContent = data.length + ' questions found in this topic.';
        els.questionsList.innerHTML = '';
        
        if (data.length === 0) {
          els.questionsList.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-muted); background: rgba(4, 17, 31, 0.4); border-radius: 8px; border: 1px dashed var(--border-gold);">No questions currently uploaded for this topic.</div>';
          if (els.bulkActions) els.bulkActions.style.display = 'none';
          return;
        }
        
        data.forEach((q, idx) => {
          const card = document.createElement('div');
          card.className = 'question-card';
          
          const getOptText = (opts) => {
            if (!Array.isArray(opts)) return '';
            return opts.map(o => {
               const isCorrect = Array.isArray(q.correct_answers) && q.correct_answers.includes(o.id.toLowerCase());
               return `<div style="${isCorrect ? 'color: #4ade80; font-weight: 600;' : ''}">${o.id.toUpperCase()}. ${o.text} ${isCorrect ? '✓' : ''}</div>`;
            }).join('');
          };

          card.innerHTML = `
            <div style="margin-right: 16px; padding-top: 2px;">
                <input type="checkbox" class="q-checkbox" value="${q.id}" style="width: 18px; height: 18px; cursor: pointer;">
              </div>
              <div class="question-content">
              <div class="question-stem">${idx + 1}. ${q.question_stem}</div>
              <div class="question-options">
                ${getOptText(q.options)}
              </div>
              ${q.rationale ? `<div style="margin-top: 8px; font-size: 12px; color: var(--text-muted);"><em>Rationale: ${q.rationale}</em></div>` : ''}
            </div>
            <button class="btn-danger" onclick="deleteQuestion('${q.id}')">Delete</button>
          `;
          els.questionsList.appendChild(card);
        });
        if (els.bulkActions) els.bulkActions.style.display = 'flex';
        if (els.selectAllCheckbox) els.selectAllCheckbox.checked = false;
        window.window.updateBulkBtn();
        document.querySelectorAll('.q-checkbox').forEach(cb => cb.addEventListener('change', updateBulkBtn));
        if (els.bulkActions) els.bulkActions.style.display = 'flex';
        if (els.selectAllCheckbox) els.selectAllCheckbox.checked = false;
        window.window.updateBulkBtn();
        document.querySelectorAll('.q-checkbox').forEach(cb => cb.addEventListener('change', updateBulkBtn));
      } catch (err) {
        logMessage('Error loading questions: ' + err.message, 'error');
        els.questionsList.innerHTML = '<div style="color: red;">Failed to load questions. See log.</div>';
      }
    }

    els.topic.addEventListener('change', loadTopicQuestions);
    if (els.refreshBtn) els.refreshBtn.addEventListener('click', loadTopicQuestions);
    
    window.deleteQuestion = async function(id) {
       if (!confirm("Are you sure you want to permanently delete this question?")) return;
       
       try {
         const { error } = await db.from('test_questions').delete().eq('id', id);
         if (error) throw error;
         logMessage("Question deleted successfully.", "success");
         loadTopicQuestions(); // Refresh list
       } catch (err) {
         logMessage("Failed to delete question: " + err.message, "error");
         alert("Delete failed. See log.");
       }
    };

    els.subject.addEventListener('change', function() {
      const subjectId = this.value;
      els.topic.innerHTML = '<option value="">-- Select Topic --</option>';
      
      if (!subjectId) {
        els.topic.disabled = true;
        return;
      }
      
      const filteredTopics = topicsData.filter(t => t.subject_id === subjectId);
      filteredTopics.forEach(t => {
        const opt = document.createElement('option');
        opt.value = t.id;
        opt.textContent = t.name;
        els.topic.appendChild(opt);
      });
      els.topic.disabled = filteredTopics.length === 0;
      if (filteredTopics.length === 0) {
        els.topic.innerHTML = '<option value="">No topics found for subject</option>';
      }
    });

    // ============================================
    // PARSER ENGINE
    // ============================================
    function parseText(text) {
      if (!text.trim()) throw new Error("No text provided.");

      const lines = text.replace(/\r\n/g, "\n").split('\n').map(l => l.trim());
      const parsedQuestions = [];
      const errors = [];
      
      let currentQ = null;
      let state = 'start'; 

      for (let i = 0; i < lines.length; i++) {
        const line = lines[i];
        if (!line) continue;
        
        if (/^(Q?\d+[\.\)]|Question \d+:)/i.test(line)) {
          if (currentQ) parsedQuestions.push(currentQ);
          currentQ = {
            _sourceBlockIndex: parsedQuestions.length + 1,
            question_stem: line.replace(/^(Q?\d+[\.\)]|Question \d+:)\s*/i, ''),
            options: [],
            correctLetters: [],
            rationale: ""
          };
          state = 'stem';
          continue;
        }
        
        if (!currentQ) continue; 
        
        if (/^(Correct Answers?|Answer|The correct answer is):?/i.test(line)) {
          const ansPrefixMatch = line.match(/^(Correct Answers?|Answer|The correct answer is):?\s*/i);
          const ansTextRaw = line.slice(ansPrefixMatch[0].length).trim();
          
          let match = ansTextRaw.match(/^([A-E])(?:\s*,\s*[A-E])*$/i);
          
          if (match) { 
            let lettersMatch = ansTextRaw.match(/[A-E]/gi);
            if (lettersMatch) {
                currentQ.correctLetters.push(...lettersMatch.map(x=>x.toUpperCase()));
            }
          } else {
            let letterMatch = ansTextRaw.match(/^([A-E])[\.\-\:\)]{0,1}\s+(.*)/i);
            if (letterMatch) {
                currentQ.correctLetters.push(letterMatch[1].toUpperCase());
                currentQ.rationale += (currentQ.rationale ? "\n" : "") + letterMatch[2];
            } else {
                currentQ._explicitAnswerText = ansTextRaw.toLowerCase();
            }
          }
          
          state = 'rationale';
          continue;
        }
        
        if (/^Rationale:/i.test(line)) {
          currentQ.rationale += (currentQ.rationale ? "\n" : "") + line.replace(/^Rationale:\s*/i, '');
          state = 'rationale';
          continue;
        }
        
        let optMatch = line.match(/^(\*?)\s*([a-zA-Z])[\.\)]\s*(.+)/i);
        let justAsterisk = line.match(/^(\*)\s*(.+)/);
        
        if (optMatch && ['a','b','c','d','e'].includes(optMatch[2].toLowerCase())) {
           state = 'options';
           const isCorrect = optMatch[1] === '*';
           const letter = optMatch[2].toUpperCase();
           const textVal = optMatch[3].trim();
           if (isCorrect) currentQ.correctLetters.push(letter);
           currentQ.options.push({ id: letter.toLowerCase(), text: textVal });
           continue;
        } else if (state === 'stem' || state === 'options') {
           if (currentQ.options.length >= 4) { 
             state = 'rationale';
             currentQ.rationale += (currentQ.rationale ? "\n" : "") + line;
             continue;
           }
           
           if (justAsterisk) {
             state = 'options';
             const textVal = justAsterisk[2].trim();
             const autoLetter = String.fromCharCode(97 + currentQ.options.length); 
             currentQ.correctLetters.push(autoLetter.toUpperCase());
             currentQ.options.push({ id: autoLetter, text: textVal });
             continue;
           }
           
           if (state === 'options') {
             const textVal = line;
             const autoLetter = String.fromCharCode(97 + currentQ.options.length);
             currentQ.options.push({ id: autoLetter, text: textVal });
             continue;
           }
           
           if (state === 'stem') {
             currentQ.question_stem += "\n" + line;
           }
        } else if (state === 'rationale') {
           currentQ.rationale += (currentQ.rationale ? "\n" : "") + line;
        }
      }
      
      if (currentQ) parsedQuestions.push(currentQ);
      
      const finalQuestions = [];
      parsedQuestions.forEach((q, idx) => {
        let question = q.question_stem.trim();
        let rationale = q.rationale.trim();
        let options = q.options;
        let correctLetters = q.correctLetters;
        
        if (q._explicitAnswerText && correctLetters.length === 0) {
          let found = options.find(o => o.text.toLowerCase().includes(q._explicitAnswerText) || q._explicitAnswerText.includes(o.text.toLowerCase()));
          if (found) correctLetters.push(found.id.toUpperCase());
        }

        if (options.length < 2) {
          errors.push(`Question ${idx+1}: Needs at least 2 options. Found ${options.length}.\n"${question.substring(0, 40)}..."`);
        } else if (correctLetters.length === 0) {
          errors.push(`Question ${idx+1}: Missing correct answer (prefix option with * or add 'Correct Answer: X').\n"${question.substring(0, 40)}..."`);
        }
        
        const correctIds = [...new Set(correctLetters)].map(l => l.toLowerCase());
        
        finalQuestions.push({
          _sourceBlockIndex: idx + 1,
          question_stem: question,
          options: options,
          correct_answers: correctIds,
          is_multiple_choice: correctIds.length > 1,
          rationale: rationale || null,
        });
      });

      if (errors.length > 0) throw new Error('\n' + errors.join('\n'));
      return finalQuestions;
    }

    // ============================================
    // ACTIONS
    // ============================================
    els.testBtn.addEventListener('click', () => {
      els.log.innerHTML = '';
      try {
        const res = parseText(els.src.value);
        logMessage(`✅ Successfully parsed ${res.length} valid questions.`, 'success');
        res.forEach((q, idx) => {
          logMessage(`Q${idx+1}: ${q.question_stem.substring(0, 50)}...`);
          logMessage(`  Options: ${q.options.length} | Correct: ${q.correct_answers.join(', ').toUpperCase()} | Multi: ${q.is_multiple_choice}`);
        });
      } catch(e) {
        logMessage(`❌ PARSE FAILED: ${e.message}`, 'error');
        alert("Parse Error. See log below.");
      }
    });

    els.postBtn.addEventListener('click', async () => {
      els.log.innerHTML = '';
      const subjectId = els.subject.value;
      const topicId = els.topic.value;
      const text = els.src.value;
      
      if (!subjectId || !topicId) {
        logMessage("❌ Please select both a Subject and a Topic first.", "error");
        return;
      }

      els.postBtn.disabled = true;
      els.postBtn.textContent = "Posting...";

      try {
        logMessage("Parsing questions...");
        const questions = parseText(text);
        if (questions.length === 0) throw new Error("No questions found to parse.");
        logMessage(`✅ Parsed ${questions.length} questions.`, 'success');

        logMessage("Validating DB config...");
        const config = configsData.find(c => c.subject_id === subjectId);
        if (!config) throw new Error("No active test configuration found for this subject.");
        const testId = config.id;

        const topicObj = topicsData.find(t => t.id === topicId);
        const categoryName = topicObj ? topicObj.name : 'Unknown';

        logMessage("Fetching max display_order for this topic...");
        const { data: maxData, error: maxErr } = await db
           .from('test_questions')
           .select('display_order')
           .eq('topic_id', topicId)
           .order('display_order', { ascending: false })
           .limit(1);
           
        if (maxErr) throw maxErr;
        
        let startOrder = 0;
        if (maxData && maxData.length > 0 && maxData[0].display_order != null) {
          startOrder = maxData[0].display_order;
        }

        logMessage(`Building payload for Post... (Starting display order at ${startOrder + 1})`);
        const payload = questions.map((q, idx) => ({
          test_id: testId,
          topic_id: topicId,
          question_stem: q.question_stem,
          options: q.options,
          correct_answers: q.correct_answers,
          is_multiple_choice: q.is_multiple_choice,
          rationale: q.rationale,
          category: categoryName,
          display_order: startOrder + idx + 1,
          is_active: true,
          points: 1
        }));

        logMessage(`Executing DB Insert for ${payload.length} rows...`);
        const { error: insErr } = await db.from('test_questions').insert(payload);
        if (insErr) throw insErr;
        
        logMessage(`🎉 SUCCESS: ${payload.length} questions posted to "${categoryName}".`, 'success');
        els.src.value = ''; // clear input
        loadTopicQuestions(); // refresh the list automatically
        loadTopicQuestions(); // refresh the list automatically
        
      } catch(err) {
        logMessage(`❌ POST FAILED: ${err.message}`, 'error');
        alert("Action failed. See log below for details.");
      } finally {
        els.postBtn.disabled = false;
        els.postBtn.textContent = "POST to Database";
      }
    });

    els.exportBtn.addEventListener('click', async () => {
      els.log.innerHTML = '';
      const text = els.src.value;
      if (!window.docx) {
        logMessage("DOCX library not loaded.", "error"); return;
      }

      try {
        logMessage("Parsing for Export...");
        const questions = parseText(text);
        if (questions.length === 0) throw new Error("No questions found.");
        
        const { Document, Packer, Paragraph, TextRun } = window.docx;
        const children = [];

        questions.forEach((q, idx) => {
          // Question text
          children.push(new Paragraph({
            spacing: { before: 240, after: 120 },
            children: [new TextRun({ text: `${idx + 1}. ${q.question_stem}`, font: "Roboto", size: 24 })]
          }));

          // Options
          q.options.forEach(opt => {
            const isCorrect = q.correct_answers.includes(opt.id);
            children.push(new Paragraph({
              children: [new TextRun({ text: `${opt.id.toUpperCase()}. ${opt.text}`, bold: isCorrect, font: "Roboto", size: 24 })]
            }));
          });
          
          // Rationale (Optional)
          if (q.rationale) {
             children.push(new Paragraph({
               spacing: { before: 120, after: 0 },
               children: [
                 new TextRun({ text: "Rationale: ", bold: true, font: "Roboto", size: 24, italics: true }),
                 new TextRun({ text: q.rationale, font: "Roboto", size: 24, italics: true })
               ]
             }));
          }
        });

        const doc = new Document({
          sections: [{ properties: {}, children }]
        });

        const blob = await Packer.toBlob(doc);
        saveAs(blob, "Questions_Export.docx");
        logMessage("✅ Exported to DOCX successfully.", "success");

      } catch(e) {
        logMessage(`❌ EXPORT FAILED: ${e.message}`, "error");
      }
    });

    // Run on boot
    window.addEventListener('DOMContentLoaded', init);
  </script>
</body>
</html>
